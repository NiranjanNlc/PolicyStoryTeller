# Base URL prepended to API paths (see src/api/client.ts). No trailing slash.

# --- Local dev (recommended) ---
# Leave VITE_API_URL UNSET so requests stay on whatever host:port Vite is using
# (e.g. http://localhost:5174) and /api is proxied to FastAPI on 8000.
# Never hardcode :5173 — Vite increments the port if 5173 is taken.

# --- Call FastAPI directly (skips Vite proxy; backend CORS must allow your UI origin) ---
# VITE_API_URL=http://127.0.0.1:8000

# --- Deployed API ---
# VITE_API_URL=https://your-api.example.com
